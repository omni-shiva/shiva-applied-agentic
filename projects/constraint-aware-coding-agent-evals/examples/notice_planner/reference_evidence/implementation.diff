         self._clock = clock
 
     def plan(self, notices: Iterable[Notice]) -> Plan:
-        raise NotImplementedError("Implement the synthetic notice planner")
+        now = self._clock()
+        batches: dict[str, list[Notice]] = {}
+        rejected: list[Notice] = []
+
+        for notice in notices:
